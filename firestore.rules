rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global Safety Net: Default deny everything
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSuperAdmin() {
      return isSignedIn() &&
        request.auth.token.email == 'aasaali_250000003099@uic.edu.ph' &&
        request.auth.token.email_verified == true;
    }

    function isAdmin() {
      return isSuperAdmin() ||
        (isSignedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid)));
    }

    function isValidUserProfile(data, userId) {
      return data.keys().hasAll(['userId', 'email', 'role']) &&
        data.keys().hasOnly(['userId', 'email', 'role', 'displayName', 'jobRole', 'department', 'jobDescription', 'createdAt', 'updatedAt']) &&
        data.userId == userId &&
        data.userId == request.auth.uid &&
        data.email is string &&
        data.email.size() <= 256 &&
        (data.role == 'user' || (data.role == 'admin' && isAdmin())) &&
        (!('displayName' in data) || (data.displayName is string && data.displayName.size() <= 128)) &&
        (!('jobRole' in data) || (data.jobRole is string && data.jobRole.size() <= 128)) &&
        (!('department' in data) || (data.department is string && data.department.size() <= 128)) &&
        (!('jobDescription' in data) || (data.jobDescription is string && data.jobDescription.size() <= 5000));
    }

    function isValidInteraction(data, userId) {
      return data.keys().hasAll(['id', 'userId', 'topic', 'userInput', 'geminiResponse']) &&
        data.keys().hasOnly(['id', 'userId', 'topic', 'userInput', 'geminiResponse', 'sessionTitle', 'insightsSummary', 'brainstormingIdeas', 'actionableSuggestions', 'qualityAssessment', 'createdAt', 'updatedAt']) &&
        data.userId == userId &&
        data.userId == request.auth.uid &&
        data.id is string &&
        data.id.size() <= 128 &&
        data.topic in ['work_processes', 'challenges', 'complaints', 'suggestions', 'general'] &&
        data.userInput is string &&
        data.userInput.size() <= 10000 &&
        data.geminiResponse is string &&
        data.geminiResponse.size() <= 30000 &&
        (!('sessionTitle' in data) || (data.sessionTitle is string && data.sessionTitle.size() <= 200)) &&
        (!('insightsSummary' in data) || (data.insightsSummary is string && data.insightsSummary.size() <= 5000)) &&
        (!('brainstormingIdeas' in data) || (data.brainstormingIdeas is string && data.brainstormingIdeas.size() <= 5000)) &&
        (!('actionableSuggestions' in data) || (data.actionableSuggestions is string && data.actionableSuggestions.size() <= 5000)) &&
        (!('qualityAssessment' in data) || (data.qualityAssessment is string && data.qualityAssessment.size() <= 2000));
    }

    function isValidCompanyStandard(data) {
      return data.keys().hasAll(['id', 'title', 'category', 'content', 'uploadedBy']) &&
        data.keys().hasOnly(['id', 'title', 'category', 'content', 'uploadedBy', 'uploadedByEmail', 'description', 'version', 'isActive', 'createdAt', 'updatedAt']) &&
        data.id is string &&
        data.id.size() <= 128 &&
        data.title is string &&
        data.title.size() <= 200 &&
        data.category is string &&
        data.category.size() <= 100 &&
        data.content is string &&
        data.content.size() <= 50000 &&
        data.uploadedBy == request.auth.uid;
    }

    function isValidAdminRecord(data) {
      return data.keys().hasAll(['email', 'role']) &&
        data.keys().hasOnly(['email', 'role', 'assignedAt']) &&
        data.email is string &&
        data.email.size() <= 256 &&
        data.role in ['superadmin', 'admin'];
    }

    // Admins collection
    match /admins/{adminId} {
      allow get: if isSignedIn();
      allow list: if isAdmin();
      allow write: if isSuperAdmin() && isValidId(adminId) && isValidAdminRecord(incoming());
    }

    // Company Reference Standards collection
    match /company_standards/{standardId} {
      allow get, list: if isSignedIn();
      allow create: if isAdmin() && isValidId(standardId) && isValidCompanyStandard(incoming());
      allow update: if isAdmin() && isValidId(standardId) && isValidCompanyStandard(incoming()) && incoming().uploadedBy == existing().uploadedBy;
      allow delete: if isAdmin() && isValidId(standardId);
    }

    // User Profiles
    match /users/{userId} {
      allow get: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow list: if isAdmin();
      allow create: if isSignedIn() && request.auth.uid == userId && isValidId(userId) && isValidUserProfile(incoming(), userId);
      allow update: if isSignedIn() && request.auth.uid == userId && isValidId(userId) && isValidUserProfile(incoming(), userId) && incoming().userId == existing().userId && (incoming().role == existing().role || isAdmin());
      allow delete: if isAdmin() || (isSignedIn() && request.auth.uid == userId);

      // User Isolated Interactions
      match /interactions/{interactionId} {
        allow get: if isSignedIn() && isValidId(interactionId) && (request.auth.uid == userId || isAdmin());
        allow list: if isSignedIn() && (request.auth.uid == userId || isAdmin());
        allow create: if isSignedIn() && request.auth.uid == userId && isValidId(userId) && isValidId(interactionId) && isValidInteraction(incoming(), userId);
        allow update: if isSignedIn() && request.auth.uid == userId && isValidId(userId) && isValidId(interactionId) && isValidInteraction(incoming(), userId) && incoming().userId == existing().userId;
        allow delete: if isSignedIn() && (request.auth.uid == userId || isAdmin()) && isValidId(interactionId);
      }
    }

    // Collection group query for super admin to view audits across users
    match /{path=**}/interactions/{interactionId} {
      allow list: if isAdmin();
    }
  }
}
